{
  "name": "denosyscore/http",
  "description": "HTTP kernel, middleware, and exception handling",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "denosyscore/container": "^0.17",
    "denosyscore/contracts": "^0.17",
    "denosyscore/routing": "^0.17",
    "denosyscore/session": "^0.17",
    "denosyscore/validation": "^0.17",
    "filp/whoops": "^2.18",
    "laminas/laminas-diactoros": "^3.6",
    "psr/http-message": "^2.0",
    "psr/http-server-handler": "^1.0",
    "psr/http-server-middleware": "^1.0",
    "psr/log": "^2.0 || ^3.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^10.5"
  },
  "suggest": {
    "denosyscore/routing": "Provides typed routing HTTP exceptions for HttpExceptionMiddleware",
    "denosyscore/session": "Provides the session contract for session-aware HTTP middleware"
  },
  "autoload": {
    "files": [
      "src/legacy-validation-handler.php"
    ],
    "psr-4": {
      "Denosys\\Http\\": "src/Http/",
      "Denosys\\Http\\Exceptions\\": "src/Exceptions/",
      "Denosys\\Http\\Security\\": "src/Security/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse --no-progress --memory-limit=1G"
  },
  "config": {
    "sort-packages": true
  },
  "extra": {
    "branch-alias": {
      "dev-main": "0.17.x-dev"
    }
  }
}
